<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Mochi icon: call Mochi or start a new chat straight away. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="call" android:enabled="true" android:icon="@drawable/ic_mochi"
        android:shortcutShortLabel="@string/shortcut_call" android:shortcutLongLabel="@string/shortcut_call">
        <intent android:action="app.mochi.phone.CALL" android:targetPackage="app.mochi.phone"
            android:targetClass="app.mochi.phone.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="chat" android:enabled="true" android:icon="@drawable/ic_mochi"
        android:shortcutShortLabel="@string/shortcut_chat" android:shortcutLongLabel="@string/shortcut_chat">
        <intent android:action="app.mochi.phone.NEW_CHAT" android:targetPackage="app.mochi.phone"
            android:targetClass="app.mochi.phone.ChatActivity" />
    </shortcut>
</shortcuts>
